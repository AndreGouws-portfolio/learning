# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/orbit_crm"

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: used by `npm run db:seed` to create the first demo user
SEED_USER_EMAIL="demo@orbitcrm.app"
SEED_USER_PASSWORD="password123"
