# Copy this file to .env and fill in real values before running the app.

# A Postgres connection string (Neon, Supabase, Vercel Postgres, or your own). See README.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- App auth ---
# A single shared password for accessing the tracker (it holds client emails/PII, so keep it protected).
ADMIN_PASSWORD="choose-a-strong-password"
# Random string used to sign the login session cookie. Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET="generate-a-long-random-string"

# --- Outgoing email (used to send payment reminders) ---
# Any SMTP provider works (Gmail, Resend, Postmark, SendGrid SMTP, etc). See README for Gmail setup.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="you@example.com"
SMTP_PASS="your-smtp-password-or-app-password"
EMAIL_FROM="you@example.com"
