# Copy this file to .env and fill in your own values.

# --- Required: database ---
# Your Neon Postgres connection string (from neon.tech project dashboard).
# The app won't start without this.
DATABASE_URL=

# Random string used to sign Flask's session cookies (flash messages, etc).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Optional: WhatsApp / Messenger integration ---
# Nothing below is required to run the CRM itself. See README.md for the
# full setup walkthrough (Meta app config + webhooks).

# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you make up yourself - enter the same value in the Meta
# webhook config when you click "Verify and Save".
WHATSAPP_VERIFY_TOKEN=

# From Meta App Dashboard > Messenger > Settings > Access Tokens
MESSENGER_PAGE_TOKEN=
MESSENGER_VERIFY_TOKEN=

# From Meta App Dashboard > App Settings > Basic > App Secret.
# Used to verify that webhook requests really came from Meta. Optional but
# strongly recommended - without it, anyone who finds your webhook URL
# could inject fake messages into your CRM.
META_APP_SECRET=
